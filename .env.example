# MAX Web Messenger — build-time переменные (Vite вшивает их в бандл при `npm run build`).
# Runtime `environment:` в docker-compose для них НЕ работает — только build.args (см. docker-compose.yml + Dockerfile).
# Скопируйте в .env перед сборкой: `cp .env.example .env`

# Доверенные origins родителя для postMessage-моста (comma-separated).
# Без него виджет в PROD отбрасывает все входящие команды (fail-closed).
# Пример: VITE_TRUSTED_PARENT_ORIGINS=https://crm.example.com,https://portal.example.com
VITE_TRUSTED_PARENT_ORIGINS=

# Дефолтный шлюз GREEN-API (опционально, по умолчанию https://3100.api.green-api.com).
# Должен входить в allowlist *.green-api.com / *.greenapi.com, иначе будет отклонён.
# Пример: VITE_DEFAULT_API_URL=https://3100.api.green-api.com
VITE_DEFAULT_API_URL=https://3100.api.green-api.com

# BFF-прокси для multi-user продакшена (опционально, см. bff/README.md).
# Когда задан — в Настройках → Подключение появляется тумблер «BFF-прокси»:
# send/receive/ack идут без токена в браузере (токен — в vault на сервере).
# Пример: VITE_BFF_URL=https://bff.example.com
VITE_BFF_URL=

# GREEN-API credentials (idInstance / apiTokenInstance) в .env НЕ хранятся:
# вводятся в UI AuthScreen и лежат в sessionStorage (по умолчанию) или localStorage («Запомнить»).
